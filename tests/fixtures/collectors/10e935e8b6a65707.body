[{"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2026-07-28", "id": 361238863, "tag_name": "2026-07-28", "name": "2026-07-28", "draft": false, "prerelease": false, "created_at": "2026-07-28T16:44:35Z", "published_at": "2026-07-28T16:47:49Z", "body": "This release marks the **stable release** of the `2026-07-28` revision of the Model Context Protocol.\n\nThe specification is available on the [official Model Context Protocol website](https://modelcontextprotocol.io/specification/2026-07-28).\n\nFor a detailed overview of changes, see [2026-07-28 changelog](https://modelcontextprotocol.io/specification/2026-07-28/changelog).\n"}, {"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2026-07-28-RC", "id": 331515066, "tag_name": "2026-07-28-RC", "name": "2026-07-28 RC", "draft": false, "prerelease": true, "created_at": "2026-05-29T12:49:07Z", "published_at": "2026-05-29T12:51:22Z", "body": "This release marks the **release candidate (RC)** `2026-07-28` revision of the Model Context Protocol.\r\n\r\nThe specification is available in [draft form](https://modelcontextprotocol.io/specification/draft).\r\n\r\nFor a detailed overview of changes, see [2026-07-28 draft changelog](https://modelcontextprotocol.io/specification/draft/changelog).\r\n\r\n>[!NOTE]\r\n>**To users and implementers:** this specification is not final. Changes may be introduced between the RC and the final release. SDKs will adopt this version at their own pace, and the prior version of the spec may remain in use for an undetermined amount of time.\r\n>\r\n>Refer to the [Version Negotiation documentation](https://modelcontextprotocol.io/specification/draft/basic/lifecycle#version-negotiation) to learn about the process for clients and servers to determine the version of the protocol being used.\r\n"}, {"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2025-11-25", "id": 265270383, "tag_name": "2025-11-25", "name": "2025-11-25", "draft": false, "prerelease": false, "created_at": "2025-11-25T21:14:08Z", "published_at": "2025-11-25T21:17:42Z", "body": "This release marks the **stable release** of the `2025-11-25` revision of the Model Context Protocol.\r\n\r\nThe specification is available on the [official Model Context Protocol website](https://modelcontextprotocol.io/specification/2025-11-25).\r\n\r\nFor a detailed overview of changes, see [2025-11-25 changelog](https://modelcontextprotocol.io/specification/2025-11-25/changelog)."}, {"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2025-11-25-RC", "id": 262635836, "tag_name": "2025-11-25-RC", "name": "2025-11-25-RC", "draft": false, "prerelease": true, "created_at": "2025-11-15T00:13:55Z", "published_at": "2025-11-15T06:06:55Z", "body": "This release marks the **release candidate (RC)** `2025-11-25` revision of the Model Context Protocol.\r\n\r\nThe specification is available in [draft form](https://modelcontextprotocol.io/specification/draft).\r\n\r\nFor a detailed overview of changes, see [2025-11-25 draft changelog](https://modelcontextprotocol.io/specification/draft/changelog).\r\n\r\n>[!NOTE]\r\n>**To users and implementers:** this specification is not final. Changes may be introduced between the RC and the final release. SDKs will adopt this version at their own pace, and the prior version of the spec may remain in use for an undetermined amount of time.\r\n>\r\n>Refer to the [Version Negotiation documentation](https://modelcontextprotocol.io/specification/draft/basic/lifecycle#version-negotiation) to learn about the process for clients and servers to determine the version of the protocol being used."}, {"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2025-06-18", "id": 226276011, "tag_name": "2025-06-18", "name": "2025-06-18", "draft": false, "prerelease": false, "created_at": "2025-06-18T20:07:38Z", "published_at": "2025-06-18T20:09:59Z", "body": "This release marks the initial 2025-06-18 revision of the Model Context Protocol.\r\n\r\nFor a detailed overview of changes, see [2025-06-18 changelog](https://modelcontextprotocol.io/specification/2025-06-18/changelog).\r\n\r\n_To users and implementors:_ note that SDKs will adopt this version at their own pace, and the prior version of the spec may remain in use for an undetermined amount of time. The spec describes how clients and servers perform version negotiation with one another, permitting backwards and forwards compatibility."}, {"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2025-03-26", "id": 208423411, "tag_name": "2025-03-26", "name": "2025-03-26", "draft": false, "prerelease": false, "created_at": "2025-03-26T14:25:05Z", "published_at": "2025-03-26T14:28:27Z", "body": "This release marks the initial 2025-03-26 revision of the Model Context Protocol.\r\n\r\n_To users and implementors:_ note that SDKs will adopt this version at their own pace, and the prior version of the spec may remain in use for an undetermined amount of time. The spec describes how clients and servers perform version negotiation with one another, permitting backwards and forwards compatibility."}, {"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2024-11-05-final", "id": 208412249, "tag_name": "2024-11-05-final", "name": "2024-11-05-final", "draft": false, "prerelease": false, "created_at": "2025-03-26T13:14:14Z", "published_at": "2025-03-26T13:53:30Z", "body": "This release marks the final 2024-11-05 revision of the Model Context Protocol, including all backwards compatible changes made since [the initial 2024-11-05 release](https://github.com/modelcontextprotocol/specification/releases/tag/2024-11-05)."}, {"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2024-11-05", "id": 195404339, "tag_name": "2024-11-05", "name": "2024-11-05", "draft": false, "prerelease": false, "created_at": "2025-01-17T20:35:31Z", "published_at": "2025-01-17T20:37:02Z", "body": "This release marks the initial 2024-11-05 revision of the Model Context Protocol."}, {"html_url": "https://github.com/modelcontextprotocol/modelcontextprotocol/releases/tag/2024-10-07", "id": 183905491, "tag_name": "2024-10-07", "name": "2024-10-07", "draft": false, "prerelease": false, "created_at": "2024-11-06T10:58:55Z", "published_at": "2024-11-06T10:59:21Z", "body": "Final update to version 2024-10-07 of the spec."}]