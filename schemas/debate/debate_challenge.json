{
 "type": "object",
 "properties": {
  "question_id": {
   "type": "string",
   "enum": [
    "q1",
    "q2",
    "q3",
    "q4",
    "q5"
   ]
  },
  "steelman": {
   "type": "string",
   "description": "the other view's best case in at most two sentences, in terms it would accept"
  },
  "crux": {
   "type": "object",
   "properties": {
    "claim": {
     "type": "string",
     "description": "the single factual or causal claim the disagreement turns on"
    },
    "type": {
     "type": "string",
     "enum": [
      "factual",
      "causal",
      "definitional",
      "timing"
     ]
    },
    "observable": {
     "type": "string",
     "description": "what you would look at to settle it"
    },
    "by_date": {
     "type": "string",
     "description": "YYYY-MM-DD or empty"
    }
   },
   "required": [
    "claim",
    "type",
    "observable",
    "by_date"
   ],
   "additionalProperties": false
  },
  "rebuttal": {
   "type": "string",
   "description": "at most 120 words, plain prose, no headings"
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "section": {
      "type": "string",
      "description": "package section name, e.g. ON-CHAIN & MARKET DATA"
     },
     "quote": {
      "type": "string",
      "description": "text copied verbatim from the package, at most 200 characters"
     }
    },
    "required": [
     "section",
     "quote"
    ],
    "additionalProperties": false
   }
  },
  "would_change_my_mind": {
   "type": "object",
   "properties": {
    "observable": {
     "type": "string"
    },
    "level": {
     "type": "string",
     "description": "level or event"
    },
    "by_date": {
     "type": "string",
     "description": "YYYY-MM-DD or empty"
    }
   },
   "required": [
    "observable",
    "level",
    "by_date"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "question_id",
  "steelman",
  "crux",
  "rebuttal",
  "evidence",
  "would_change_my_mind"
 ],
 "additionalProperties": false
}
