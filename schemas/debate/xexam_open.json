{
 "type": "object",
 "properties": {
  "question_id": {
   "type": "string",
   "enum": [
    "q1",
    "q2",
    "q3",
    "q4",
    "q5"
   ]
  },
  "steelman": {
   "type": "string",
   "description": "the other view's best case in at most two sentences, in terms it would accept"
  },
  "i_am_wrong_if": {
   "type": "object",
   "properties": {
    "observable": {
     "type": "string",
     "description": "the series or event, as specific as a reader could check it"
    },
    "source": {
     "type": "string",
     "description": "where it is published"
    },
    "comparator": {
     "type": "string",
     "enum": [
      ">",
      ">=",
      "<",
      "<=",
      "happens",
      "does_not_happen"
     ]
    },
    "level": {
     "type": "string",
     "description": "the level as written, e.g. 90B or 5.4%; empty for happens / does_not_happen"
    },
    "by_date": {
     "type": "string",
     "description": "YYYY-MM-DD"
    },
    "if_true": {
     "type": "string",
     "enum": [
      "yes_more_likely",
      "no_more_likely"
     ],
     "description": "what the indicator coming true means for the question"
    }
   },
   "required": [
    "observable",
    "source",
    "comparator",
    "level",
    "by_date",
    "if_true"
   ],
   "additionalProperties": false
  },
  "rebuttal": {
   "type": "string",
   "description": "at most 120 words, plain prose, no headings"
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "section": {
      "type": "string",
      "description": "package section name, e.g. ON-CHAIN & MARKET DATA"
     },
     "quote": {
      "type": "string",
      "description": "text copied verbatim from the package, at most 200 characters"
     }
    },
    "required": [
     "section",
     "quote"
    ],
    "additionalProperties": false
   }
  },
  "probability": {
   "type": "integer",
   "description": "integer 0-100: your probability now"
  }
 },
 "required": [
  "question_id",
  "steelman",
  "i_am_wrong_if",
  "rebuttal",
  "evidence",
  "probability"
 ],
 "additionalProperties": false
}
