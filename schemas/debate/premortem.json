{
 "type": "object",
 "properties": {
  "question_id": {
   "type": "string",
   "enum": [
    "q1",
    "q2",
    "q3",
    "q4",
    "q5"
   ]
  },
  "consensus_view": {
   "type": "string",
   "description": "the view that turned out wrong, one sentence"
  },
  "failure_story": {
   "type": "string",
   "description": "at most 150 words: why it was wrong, built on today's data"
  },
  "early_signs": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "observable": {
      "type": "string",
      "description": "the series or event, as specific as a reader could check it"
     },
     "source": {
      "type": "string",
      "description": "where it is published"
     },
     "comparator": {
      "type": "string",
      "enum": [
       ">",
       ">=",
       "<",
       "<=",
       "happens",
       "does_not_happen"
      ]
     },
     "level": {
      "type": "string",
      "description": "the level as written, e.g. 90B or 5.4%; empty for happens / does_not_happen"
     },
     "by_date": {
      "type": "string",
      "description": "YYYY-MM-DD"
     },
     "if_true": {
      "type": "string",
      "enum": [
       "yes_more_likely",
       "no_more_likely"
      ],
      "description": "what the indicator coming true means for the question"
     }
    },
    "required": [
     "observable",
     "source",
     "comparator",
     "level",
     "by_date",
     "if_true"
    ],
    "additionalProperties": false
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "section": {
      "type": "string",
      "description": "package section name, e.g. ON-CHAIN & MARKET DATA"
     },
     "quote": {
      "type": "string",
      "description": "text copied verbatim from the package, at most 200 characters"
     }
    },
    "required": [
     "section",
     "quote"
    ],
    "additionalProperties": false
   }
  },
  "probability": {
   "type": "integer",
   "description": "integer 0-100: your own probability that the answer is yes"
  }
 },
 "required": [
  "question_id",
  "consensus_view",
  "failure_story",
  "early_signs",
  "evidence",
  "probability"
 ],
 "additionalProperties": false
}
