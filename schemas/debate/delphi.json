{
 "type": "object",
 "properties": {
  "revisions": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "question_id": {
      "type": "string",
      "enum": [
       "q1",
       "q2",
       "q3",
       "q4",
       "q5"
      ]
     },
     "verdict": {
      "type": "string",
      "enum": [
       "hold",
       "revise"
      ],
      "description": "hold is the default"
     },
     "new_probability": {
      "type": "integer",
      "description": "integer 0-100: your probability now (your take when you hold)"
     },
     "moved_by": {
      "type": "string",
      "enum": [
       "reason_a",
       "reason_b",
       "own_recheck",
       "none"
      ]
     },
     "reason": {
      "type": "string",
      "description": "at most 40 words"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "section": {
         "type": "string",
         "description": "package section name, e.g. ON-CHAIN & MARKET DATA"
        },
        "quote": {
         "type": "string",
         "description": "text copied verbatim from the package, at most 200 characters"
        }
       },
       "required": [
        "section",
        "quote"
       ],
       "additionalProperties": false
      }
     },
     "would_change_my_mind": {
      "type": "object",
      "properties": {
       "observable": {
        "type": "string",
        "description": "the series or event, as specific as a reader could check it"
       },
       "source": {
        "type": "string",
        "description": "where it is published"
       },
       "comparator": {
        "type": "string",
        "enum": [
         ">",
         ">=",
         "<",
         "<=",
         "happens",
         "does_not_happen"
        ]
       },
       "level": {
        "type": "string",
        "description": "the level as written, e.g. 90B or 5.4%; empty for happens / does_not_happen"
       },
       "by_date": {
        "type": "string",
        "description": "YYYY-MM-DD"
       },
       "if_true": {
        "type": "string",
        "enum": [
         "yes_more_likely",
         "no_more_likely"
        ],
        "description": "what the indicator coming true means for the question"
       }
      },
      "required": [
       "observable",
       "source",
       "comparator",
       "level",
       "by_date",
       "if_true"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "question_id",
     "verdict",
     "new_probability",
     "moved_by",
     "reason",
     "evidence",
     "would_change_my_mind"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "revisions"
 ],
 "additionalProperties": false
}
