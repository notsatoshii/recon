{
 "type": "object",
 "properties": {
  "question_id": {
   "type": "string",
   "enum": [
    "q1",
    "q2",
    "q3",
    "q4",
    "q5"
   ]
  },
  "consensus_view": {
   "type": "string",
   "description": "the view you argue against, one sentence"
  },
  "case": {
   "type": "string",
   "description": "the strongest case against it, at most 150 words"
  },
  "crux": {
   "type": "object",
   "properties": {
    "claim": {
     "type": "string"
    },
    "type": {
     "type": "string",
     "enum": [
      "factual",
      "causal",
      "definitional",
      "timing"
     ]
    },
    "observable": {
     "type": "string"
    },
    "by_date": {
     "type": "string",
     "description": "YYYY-MM-DD or empty"
    }
   },
   "required": [
    "claim",
    "type",
    "observable",
    "by_date"
   ],
   "additionalProperties": false
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "section": {
      "type": "string",
      "description": "package section name, e.g. ON-CHAIN & MARKET DATA"
     },
     "quote": {
      "type": "string",
      "description": "text copied verbatim from the package, at most 200 characters"
     }
    },
    "required": [
     "section",
     "quote"
    ],
    "additionalProperties": false
   }
  },
  "probability": {
   "type": "integer",
   "description": "integer 0-100: your own probability that the answer is yes"
  },
  "would_change_my_mind": {
   "type": "object",
   "properties": {
    "observable": {
     "type": "string"
    },
    "level": {
     "type": "string"
    },
    "by_date": {
     "type": "string",
     "description": "YYYY-MM-DD or empty"
    }
   },
   "required": [
    "observable",
    "level",
    "by_date"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "question_id",
  "consensus_view",
  "case",
  "crux",
  "evidence",
  "probability",
  "would_change_my_mind"
 ],
 "additionalProperties": false
}
