# RECON configuration
# Copy to ~/.recon.env (or set RECON_ENV to its path), then: chmod 600 ~/.recon.env
# Every script loads it automatically.

# ── LLM backend ──────────────────────────────────────────────
# codex (default, ChatGPT subscription via `codex login`) | claude | dry-run
export RECON_LLM_PROVIDER=codex

# Model tiers. Call sites name a tier, never a model.
#   fast     votes, classification, memory/state updates, picks, sentiment
#   analyst  agent takes, challenges, responses, deep dives
#   synth    brief draft, hallucination pass, digest/radar synthesis
export RECON_MODEL_FAST=gpt-5.6-luna
export RECON_MODEL_ANALYST=gpt-5.6-terra
export RECON_MODEL_SYNTH=gpt-5.6-sol
# Reasoning effort per tier: minimal | low | medium | high | xhigh
export RECON_EFFORT_FAST=low
export RECON_EFFORT_ANALYST=medium
export RECON_EFFORT_SYNTH=high

# Optional: Claude CLI provider mapping (only used when RECON_LLM_PROVIDER=claude)
# export RECON_CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
# export RECON_CLAUDE_MODEL_ANALYST=claude-sonnet-5
# export RECON_CLAUDE_MODEL_SYNTH=claude-opus-5

# Per-call timeout (s) and attempts
export RECON_LLM_TIMEOUT=420
export RECON_LLM_RETRIES=3

# ── Telegram (create bot via @BotFather) ─────────────────────
export RECON_TELEGRAM_TOKEN=
export RECON_TELEGRAM_CHAT_ID=
# Set to 1 to run without sending anything (same as --no-telegram)
# export RECON_NO_TELEGRAM=1

# ── Paths (defaults are fine when running from the repo) ─────
# export RECON_HOME=/home/recon/recon-v2
# export RECON_VENV=/home/recon/recon-venv
# export RECON_TWSCRAPE_DB=/home/recon/.recon_twscrape.db

# ── Optional data-source keys (not required; RSS/public APIs are used) ──
export REDDIT_CLIENT_ID=
export REDDIT_CLIENT_SECRET=
export REDDIT_USER_AGENT=RECON/1.0
export CRYPTOPANIC_API_KEY=
export DUNE_API_KEY=
